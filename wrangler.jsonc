{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novanew",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "deba3751-67fb-455c-8ebd-18e204bd7730","database_name": "novanew" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "952f38cad3b74a608c0077334ab15821" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
